# API Configuration
# Local Supabase Edge Functions development server (default port 8000)
VITE_API_URL=http://localhost:8000/api/v1

# Supabase Project Configuration (Optional for client-side direct access)
VITE_SUPABASE_URL=https://zxsizwzjktorqjlzzchg.supabase.co
VITE_SUPABASE_ANON_KEY=

# Firebase Cloud Messaging (browser push notifications)
# All five are public, client-side config values — same non-secret model as
# the Supabase anon key above, safe to ship in the bundle. Get them from the
# Firebase console: Project settings > General (the apiKey/projectId/etc.)
# and Project settings > Cloud Messaging > Web configuration (the VAPID key).
# Push notifications no-op gracefully with these unset — see
# src/hooks/usePushNotifications.ts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
